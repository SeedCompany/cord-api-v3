# PostgreSQL — the primary (and only) database.
# `sslmode=no-verify`: the local compose server presents a self-signed cert
# (the API's PG client always performs an SSL handshake).
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/cord?sslmode=no-verify

# Email
EMAIL_SEND=false
EMAIL_OPEN=true

# DBL Upload Notifications (optional)
#NOTIFY_DBL_UPLOAD=true
#DBL_UPLOAD_REPLY_TO=your-email@example.com
#DBL_REQUEST_FORM_URL=https://your-form-url.com

# Auth0 (optional; required for the loginWithAuth0 mutation)
#AUTH0_DOMAIN=your-tenant.us.auth0.com
#AUTH0_AUDIENCE=your-api-audience
# Identifier of the Auth0 API that represents Cord; enables assistant (MCP) access tokens
#AUTH0_API_AUDIENCE=https://cord-api.example
