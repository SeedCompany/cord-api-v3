{
  "collection": "@nestjs/schematics",
  "generateOptions": {
    "spec": false
  },
  "compilerOptions": {
    "assets": [
      {
        "include": "core/database/drizzle/migrations/**/*.sql",
        "outDir": "./dist/src",
        "watchAssets": true
      },
      {
        "include": "core/drizzle/rds-ca-bundle.pem",
        "outDir": "./dist/src",
        "watchAssets": true
      }
    ]
  }
}
